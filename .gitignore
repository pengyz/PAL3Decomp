# Original binary (do not commit copyrighted game files)
original/
*.exe
*.dll

# Build outputs
build/
*.obj
*.o
*.lib
*.pdb
*.ilk
*.exp

# IDE files
.vs/
*.suo
*.user
*.ncb
*.aps
.idea/
*.swp
*~

# Ghidra installation (large, downloadable)
tools/ghidra/

# Ghidra project files (large, regenerable)
*.gpr
*.rep/
*.lock

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Local config (user-specific paths, never commit)
local_config.json

# API keys (never commit)
.env
*.key

# Temporary files
*.tmp
*.bak
asm/gbengine/*.json

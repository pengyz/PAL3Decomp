Makefile

# OS
.DS_Store
Thumbs.db
desktop.ini

# Verification builds
build/verify/

# Git worktrees
.worktrees/

# Claude Code local state (not commands)
.claude/align_cursor.json
.claude/iterations/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# VC6 compiled object files (build artifacts)
tools/vc6/*.obj

# Temp files
test_layout*.i
annotate_unknowns.py
annotation_summary_*.txt

# Ghidra project databases (large binary, regenerable)
*.rep/
*.gpr

# Build output directories (CMake)
build_*/

# Tool binaries (downloaded separately)
tools/ghidra/
tools/mingw/
tools/tcc/
tools/tcc.zip

# VC6 SP5 installer (no longer needed)
tools/vc6sp5/

# VC6 toolchain: tracked via Git LFS (override global *.exe/*.dll rules)
!tools/vc6/**

# VC6 temp test files (re-ignore after !tools/vc6/**)
tools/vc6/test_pragma*.cpp

# VC6 lowercase symlinks for Linux case-sensitivity (generated by setup script)
tools/vc6/Include/[a-z_]*
tools/vc6/Lib/[a-z_]*

# Fulldump utilities (local builds)
tools/fulldump/

# Obsolete/experimental scripts
tools/_obsolete/

# IDA run logs and intermediate results
tools/ida/_logs/
pipeline/ida/_logs/
asm/pal3a/*.log
asm/pal3a/*.lock

# Decompilation output (large, regenerable from IDA)
asm/pal3a/decomp/

# IDA databases and disassembly (large, local work files)
original/*.asm

# AI-generated plans and specs (not part of source)
docs/superpowers/

# Original binaries - only track exe/dll/pdb via LFS
!original/*.exe
!original/*.dll
!original/*.pdb
!original/*.bin
!original/*.xml

# PAL3.exe IDA export data (generated, regenerate with pal3_master_pipeline.py)
asm/pal3/*.json
!asm/pal3/_export_summary.json
!asm/pal3/call_graph.json

# gbengine IDA alias files (generated, regenerable)
asm/gbengine_ida/*_alias.json

# VC6 RTM compiler tracked via Git LFS (override global *.exe/*.dll rules)
!tools/compilers/**
# Generated source code (regenerable from gen_headers.py / gen_cpp.py)
# Do NOT manually edit these — improve IDA annotations instead
include/pal3/gen/
src/pal3/

# Decomp JSON (regenerable from IDA export)
asm/pal3/decomp/

# IDA databases (regenerable from pipeline: master_pipeline + apply_annotations)
*.i64
*.id0
*.id1
*.id2
*.nam
*.til
*.i64.bak
*.id0.bak
include/pal3/globals.h

# Pipeline snapshots (large compile output, regenerable)
pipeline/snapshots/data/

# Build output log (regenerable)
build_output.txt

# AIDE project state (local tool state)
.project/audit.log
.project/state.json
.project/knowledge/

# Temp analysis scripts
analyze*.py
tmp_*.py
_tmp_plugin/

pipeline.toml
.claude/skills/gstack/

# Claude Code metadata
.omo/

# Temp analysis scripts
__*.py
_ccct_*/

# IDE / personal config
.opencode/

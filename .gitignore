# Build directories
build/
*.obj
*.o
*.exe
*.dll
*.lib
*.exp
*.ilk
*.pdb
*.suo
*.user
*.sdf
*.opensdf

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Local config
local_config.json

# IDE
.vs/
.vscode/
*.swp
*.swo
*~

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# OS
.DS_Store
Thumbs.db
desktop.ini

# Verification builds
build/verify/

# Git worktrees
.worktrees/

# Claude Code local state (not commands)
.claude/align_cursor.json
.claude/iterations/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# VC6 compiled object files (build artifacts)
tools/vc6/*.obj

# Temp files
test_layout*.i
annotate_unknowns.py
annotation_summary_*.txt

# Ghidra project databases (large binary, regenerable)
*.rep/
*.gpr

# Build output directories (CMake)
build_*/

# Tool binaries (downloaded separately)
tools/ghidra/
tools/mingw/
tools/tcc/
tools/tcc.zip

# VC6 SP5 installer (no longer needed)
tools/vc6sp5/

# VC6 toolchain: tracked via Git LFS (override global *.exe/*.dll rules)
!tools/vc6/**

# VC6 temp test files (re-ignore after !tools/vc6/**)
tools/vc6/test_pragma*.cpp

# VC6 lowercase symlinks for Linux case-sensitivity (generated by setup script)
tools/vc6/Include/[a-z_]*
tools/vc6/Lib/[a-z_]*

# Fulldump utilities (local builds)
tools/fulldump/

# Obsolete/experimental scripts
tools/_obsolete/

# IDA run logs and intermediate results
tools/ida/_logs/
asm/pal3a/*.log
asm/pal3a/*.lock

# Decompilation output (large, regenerable from IDA)
asm/pal3a/decomp/

# IDA databases and disassembly (large, local work files)
original/*.asm
original/*.i64

# AI-generated plans and specs (not part of source)
docs/superpowers/

# Original binaries - only track exe/dll/pdb via LFS
!original/*.exe
!original/*.dll
!original/*.pdb
!original/*.bin
!original/*.xml

# PAL3.exe IDA export data (generated, regenerate with pal3_master_pipeline.py)
asm/pal3/*.json
!asm/pal3/_export_summary.json

# gbengine IDA alias files (generated, regenerable)
asm/gbengine_ida/*_alias.json

# VC6 RTM compiler tracked via Git LFS (override global *.exe/*.dll rules)
!tools/compilers/**

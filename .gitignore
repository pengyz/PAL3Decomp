# Build directories
build/
*.obj
*.o
*.exe
*.dll
*.lib
*.exp
*.ilk
*.pdb
*.suo
*.user
*.sdf
*.opensdf

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Local config
local_config.json

# IDE
.vs/
.vscode/
*.swp
*.swo
*~

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# OS
.DS_Store
Thumbs.db
desktop.ini

# Verification builds
build/verify/

# Git worktrees
.worktrees/

# Claude Code metadata
.claude/

# Ghidra project databases (large binary, regenerable)
*.rep/
*.gpr

# Build output directories (CMake)
build_*/

# Tool binaries (downloaded separately)
tools/ghidra/
tools/mingw/
tools/tcc/
tools/tcc.zip

# Obsolete/experimental scripts
tools/_obsolete/

# IDA run logs and intermediate results
tools/ida/_logs/

# Decompilation output (large, regenerable from IDA)
asm/pal3a/decomp/

# Original binaries - override global ignores (tracked via LFS)
!original/*.exe
!original/*.dll
!original/*.pdb
!original/*.i64
!original/*.bin
!original/*.xml

{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write(data/annotations/*)",
        "hooks": [{ "command": "${AIDE_PLUGIN_ROOT}/scripts/gate_annotations.py" }]
      },
      {
        "matcher": "Edit(data/annotations/*)",
        "hooks": [{ "command": "${AIDE_PLUGIN_ROOT}/scripts/gate_annotations.py" }]
      },
      {
        "matcher": "Bash(git commit*)",
        "hooks": [{ "command": "${AIDE_PLUGIN_ROOT}/scripts/gate_commit.py" }]
      },
      {
        "matcher": "Write(pipeline/*.py)",
        "hooks": [{ "command": "${AIDE_PLUGIN_ROOT}/scripts/gate_readonly.py" }]
      },
      {
        "matcher": "Edit(pipeline/*.py)",
        "hooks": [{ "command": "${AIDE_PLUGIN_ROOT}/scripts/gate_readonly.py" }]
      },
      {
        "matcher": "Write(pipeline/ida/*.py)",
        "hooks": [{ "command": "${AIDE_PLUGIN_ROOT}/scripts/gate_readonly.py" }]
      },
      {
        "matcher": "Edit(pipeline/ida/*.py)",
        "hooks": [{ "command": "${AIDE_PLUGIN_ROOT}/scripts/gate_readonly.py" }]
      },
      {
        "matcher": "Write(pipeline/gen/*.py)",
        "hooks": [{ "command": "${AIDE_PLUGIN_ROOT}/scripts/gate_readonly.py" }]
      },
      {
        "matcher": "Edit(pipeline/gen/*.py)",
        "hooks": [{ "command": "${AIDE_PLUGIN_ROOT}/scripts/gate_readonly.py" }]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [{ "command": "${AIDE_PLUGIN_ROOT}/scripts/audit_log.py" }]
      },
      {
        "matcher": "Bash(git commit*)",
        "hooks": [{ "command": "${AIDE_PLUGIN_ROOT}/scripts/post_commit_metrics.py" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "command": "${AIDE_PLUGIN_ROOT}/scripts/check_stop.py" }]
      }
    ],
    "Notification": [
      {
        "interval": 15,
        "hooks": [{ "command": "${AIDE_PLUGIN_ROOT}/scripts/pipeline_checkpoint.py" }]
      },
      {
        "interval": 8,
        "hooks": [{ "command": "${AIDE_PLUGIN_ROOT}/scripts/remind_quality.py" }]
      }
    ]
  }
}

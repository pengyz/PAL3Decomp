{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write(data/annotations/*)",
        "hooks": [{ "command": "${AIDE_PLUGIN_ROOT}/scripts/gate_annotations.sh", "timeout_ms": 15000 }]
      },
      {
        "matcher": "Edit(data/annotations/*)",
        "hooks": [{ "command": "${AIDE_PLUGIN_ROOT}/scripts/gate_annotations.sh", "timeout_ms": 15000 }]
      },
      {
        "matcher": "Bash(git commit*)",
        "hooks": [{ "command": "${AIDE_PLUGIN_ROOT}/scripts/gate_commit.sh", "timeout_ms": 15000 }]
      },
      {
        "matcher": "Write(pipeline/*.py)",
        "hooks": [{ "command": "${AIDE_PLUGIN_ROOT}/scripts/gate_readonly.sh" }]
      },
      {
        "matcher": "Edit(pipeline/*.py)",
        "hooks": [{ "command": "${AIDE_PLUGIN_ROOT}/scripts/gate_readonly.sh" }]
      },
      {
        "matcher": "Write(pipeline/ida/*.py)",
        "hooks": [{ "command": "${AIDE_PLUGIN_ROOT}/scripts/gate_readonly.sh" }]
      },
      {
        "matcher": "Edit(pipeline/ida/*.py)",
        "hooks": [{ "command": "${AIDE_PLUGIN_ROOT}/scripts/gate_readonly.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [{ "command": "${AIDE_PLUGIN_ROOT}/scripts/audit_log.sh" }]
      }
    ],
    "Stop": [
      {
        "required_tools": ["data_write"],
        "hooks": [
          { "command": "${AIDE_PLUGIN_ROOT}/scripts/distill_then_stop.sh" }
        ]
      }
    ],
    "Notification": [
      {
        "interval": 3,
        "hooks": [{ "command": "${AIDE_PLUGIN_ROOT}/scripts/remind_quality.sh" }]
      },
      {
        "interval": 10,
        "hooks": [{ "command": "${AIDE_PLUGIN_ROOT}/scripts/pipeline_checkpoint.sh", "timeout_ms": 120000 }]
      }
    ]
  }
}

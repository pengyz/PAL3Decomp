#!/bin/bash
# commit-msg hook: annotations 变更的 commit message 必须包含 Evidence 和 Confidence
#
# 安装: ln -sf ../../pipeline/hooks/commit-msg .git/hooks/commit-msg

ANNOTATIONS_PATH="pipeline/data/annotations"
MSG_FILE="$1"

# 只在 staged 包含 annotations 变更时检查
if ! git diff --cached --name-only | grep -q "$ANNOTATIONS_PATH"; then
    exit 0
fi

# 允许 revert/merge commit 跳过
MSG=$(cat "$MSG_FILE")
if echo "$MSG" | head -1 | grep -qE '^(Revert|Merge|merge)'; then
    exit 0
fi

# 允许纯 chore/fix(pipeline) 类型（不修改数据，只改脚本/配置）
if ! git diff --cached --name-only | grep -qE '\.(json|md)$'; then
    exit 0
fi

# 检查必须包含 Evidence 和 Confidence
HAS_EVIDENCE=$(echo "$MSG" | grep -ci 'Evidence\|证据\|Binary evidence\|\[A\]')
HAS_CONFIDENCE=$(echo "$MSG" | grep -ci 'Confidence\|置信度\|confidence')

if [ "$HAS_EVIDENCE" -eq 0 ] || [ "$HAS_CONFIDENCE" -eq 0 ]; then
    echo ""
    echo "[commit-msg] BLOCKED: annotations 变更的 commit message 格式不合规"
    echo ""
    echo "必须包含:"
    echo "  Evidence: [binary evidence description / VA=0xADDR: instruction]"
    echo "  Confidence: [0-100]"
    echo ""
    echo "示例:"
    echo "  iter(annotations): fix RoleSystem._field_0CE offset"
    echo "  "
    echo "  Evidence: VA=0x42ADAA: C6 86 D1000000 01 = mov byte [esi+0xD1], esi=this"
    echo "  Confidence: 90"
    echo ""
    echo "如果是工具/脚本变更（非数据），用 chore/fix(pipeline): 前缀"
    exit 1
fi

exit 0

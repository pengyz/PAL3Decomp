#!/bin/bash
# Pre-commit hook for PAL3Decomp annotations quality gate.
#
# 安装: ln -sf ../../pipeline/hooks/pre-commit .git/hooks/pre-commit
#
# 触发条件: data/annotations/ 有 staged 变更
# 检查项:
# 1. check_annotations.py 格式校验
# 2. struct 对齐/重叠（零容忍）
# 3. commit message 格式（annotations 提交必须含 Evidence + Confidence）

ANNOTATIONS_PATH="data/annotations"

if ! git diff --cached --name-only | grep -q "$ANNOTATIONS_PATH"; then
    exit 0
fi

echo "[pre-commit] 检查 annotations..."

# 1. 格式校验
python3 pipeline/check_annotations.py
if [ $? -ne 0 ]; then
    echo "[pre-commit] BLOCKED: check_annotations.py 报错"
    exit 1
fi

# 2. 对齐/重叠（零容忍）
python3 << 'PYEOF'
import json, os, sys

def scan_violations(structs_dir):
    all_structs = {}
    for fname in os.listdir(structs_dir):
        if fname.endswith('.json'):
            all_structs[fname[:-5]] = json.load(open(os.path.join(structs_dir, fname)))

    violations = set()
    for sname, d in all_structs.items():
        if d.get('pack'):
            continue
        is_union = d.get('is_union', False)
        members = d.get('known_members', {})
        sorted_m = sorted([(int(off.split('_')[0]), members[off]) for off in members], key=lambda x: x[0])
        prev_end = 0
        for off, m in sorted_m:
            t = m.get('type', '')
            base_t = t.split('[')[0].strip()
            if '*' in t or any(x in t for x in ['int','float','DWORD','unsigned long','unsigned int','LONG','UINT','BOOL']):
                align, sz = 4, 4
            elif any(x in t for x in ['short','WORD','unsigned short']):
                align, sz = 2, 2
            elif any(x in t for x in ['char','BYTE','unsigned char','bool']):
                align, sz = 1, 1
            elif 'double' in t:
                align, sz = 8, 8
            elif base_t in all_structs and all_structs[base_t].get('pack'):
                align, sz = 1, 1
            else:
                align, sz = 4, 4
            if align > 1 and off % align != 0:
                violations.add(f'ALIGN:{sname}:{off}')
            if not is_union and off < prev_end:
                violations.add(f'OVERLAP:{sname}:{off}')
            prev_end = off + sz
    return violations

violations = scan_violations('data/annotations/structs')
if violations:
    print('[pre-commit] BLOCKED: struct 违规:')
    for v in sorted(violations):
        print(f'  {v}')
    print(f'共 {len(violations)} 个违规，必须修复后才能提交')
    sys.exit(1)
PYEOF

if [ $? -ne 0 ]; then
    exit 1
fi

echo "[pre-commit] annotations OK ✓"

# Makefile - manual/pal3 (NMake - MSVC 6.0)
# Out-of-tree build: nmake /f Makefile
# Pre-generated objs.txt (build.py generates) - NMake auto-collection limited

# Directories (relative)
SRC_DIR = .
BUILD_DIR = build
GBENGINE_DIR = ..\..\gbengine
INCLUDE_DIR = ..\..\include
VC6_ROOT = ..\..\tools\compilers\msvc6.0
VC6_LIB = ..\..\tools\vc6\Lib
VC6_INCLUDE = ..\..\tools\vc6\Include

# MSVC 6.0 tools (relative)
CC = $(VC6_ROOT)\bin\cl.exe
LINK = $(VC6_ROOT)\bin\link.exe

# Flags (MSVC 6.0 - match original)
CFLAGS = /W3 /GX /O2 /Ob2 /Oi /Ot /Oy /EHsc /I$(INCLUDE_DIR) /I$(INCLUDE_DIR)\gbengine /I$(VC6_INCLUDE)
LFLAGS = /OPT:NOREF

# Target
TARGET = $(BUILD_DIR)\PAL3_manual.exe

# Libraries (relative)
LIBS = $(GBENGINE_DIR)\gbengine.lib user32.lib gdi32.lib winmm.lib

# Objects (from objs.txt - generated by build.py)
!include $(BUILD_DIR)\objs.txt

# Rules
all: $(TARGET)

$(TARGET): $(OBJS)
	$(LINK) $(LFLAGS) /OUT:$(TARGET) $(OBJS) $(LIBS)

# Generic rule: .cpp -> .obj (build/)
{$(SRC_DIR)}.cpp{$(BUILD_DIR)}.obj::
	$(CC) $(CFLAGS) /Fo$(BUILD_DIR)\ /c $<

clean:
	-del /q $(BUILD_DIR)\*.obj $(BUILD_DIR)\*.exe $(BUILD_DIR)\sources.txt $(BUILD_DIR)\objs.txt 2>nul

.PHONY: all clean
